rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================
    // Helpers de ACL colaborativa
    // ===============================

    // Usuário autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se usuário é membro ativo da visita
    function isActiveMember(visitId, uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/visits/$(visitId)/members/$(uid))
        && get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.status == 'active';
    }

    // Verifica se usuário é owner ativo da visita
    function isOwner(visitId, uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/visits/$(visitId)/members/$(uid))
        && get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.role == 'owner';
    }

    // Verifica se usuário é admin ativo da visita (owner ou papel admin)
    function isAdmin(visitId, uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/visits/$(visitId)/members/$(uid))
        && get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.status == 'active'
        && (get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.role == 'owner'
            || get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.role == 'admin');
    }

    // Pode editar notas da visita (owner, admin ou editor ativos)
    function canEditVisit(visitId, uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/visits/$(visitId)/members/$(uid))
        && get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.status == 'active'
        && (get(/databases/$(database)/documents/visits/$(visitId)/members/$(uid)).data.role in ['owner', 'admin', 'editor']);
    }

    // ===============================
    // Colaboração: Visits
    // ===============================
    match /visits/{visitId} {
      // Read: membro ativo
      allow read: if isActiveMember(visitId, request.auth.uid);

      // Create: usuário autenticado criando visita própria
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Update/delete: apenas owner
      allow update, delete: if isOwner(visitId, request.auth.uid);

      // Subcoleção: members
      match /members/{memberUserId} {
        // Get individual: membro ativo da visita OU leitura do próprio membership
        allow get: if isActiveMember(visitId, request.auth.uid)
          || (isSignedIn() && memberUserId == request.auth.uid);

        // List/query da subcoleção: próprio membership OU requester é owner/admin
        // ativo da visita. Membro comum continua precisando filtrar por userId
        // (condição sobre resource); owner/admin listam sem filtro (condição só
        // de request — avaliada uma vez por query). O collection group de members
        // tem bloco próprio mais abaixo (somente próprio membership).
        allow list: if isSignedIn()
          && (resource.data.userId == request.auth.uid
              || isAdmin(visitId, request.auth.uid));

        // Create: APENAS o bootstrap estrito do owner inicial. Membros nascem
        // somente no bootstrap da visita ou no aceite de convite (endpoint via
        // Admin SDK); sem branch admin/owner — criar membership direto concederia
        // acesso sem convite e conflitaria com a regra de re-entrada (convite novo).
        allow create: if request.auth.uid == get(/databases/$(database)/documents/visits/$(visitId)).data.userId
          && memberUserId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.visitId == visitId
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
          && !exists(/databases/$(database)/documents/visits/$(visitId)/members/$(memberUserId));

        // Update: branches separadas e excludentes.
        // (a) Owner reafirma o PRÓPRIO membership apenas de forma invariante-
        //     preservante (role owner/status active/identidade) — o push de
        //     hardening do sync-service grava exatamente esse formato (setDoc merge).
        // (b) Owner/admin gerenciam o papel de OUTRO membro ativo: alvo ≠ owner,
        //     alvo ≠ requester, papel destino na whitelist, status e identidade
        //     (id/visitId/userId) preservados. Removido não reativa por escrita
        //     direta e nenhuma branch client mexe no doc do owner.
        allow update: if (
            isOwner(visitId, request.auth.uid)
            && memberUserId == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active'
            && request.resource.data.id == resource.data.id
            && request.resource.data.visitId == visitId
            && request.resource.data.userId == memberUserId
          )
          || (
            (isOwner(visitId, request.auth.uid) || isAdmin(visitId, request.auth.uid))
            && memberUserId != request.auth.uid
            && resource.data.role != 'owner'
            && resource.data.status == 'active'
            && request.resource.data.role in ['admin', 'editor', 'viewer']
            && request.resource.data.status == resource.data.status
            && request.resource.data.id == resource.data.id
            && request.resource.data.visitId == visitId
            && request.resource.data.userId == memberUserId
          );

        // Delete: fechado para clientes. Docs de membros removidos precisam
        // sobreviver (com removedAt) para a regra do convite-novo; limpeza real
        // só via recursiveDelete do Admin SDK (exclusão da visita).
        allow delete: if false;
      }

      // Subcoleção: notes
      match /notes/{noteId} {
        // Read: membro ativo
        allow read: if isActiveMember(visitId, request.auth.uid);

        // Create/update: owner, admin ou editor + coerência do visitId
        allow create, update: if canEditVisit(visitId, request.auth.uid)
          && request.resource.data.visitId == visitId;

        // Delete: owner, admin ou editor
        allow delete: if canEditVisit(visitId, request.auth.uid);
      }

      // Subcoleção: invites
      match /invites/{inviteId} {
        // Read: owner ou admin ativo
        allow read: if isOwner(visitId, request.auth.uid)
          || isAdmin(visitId, request.auth.uid);

        // Create: owner/admin ativos com validação completa.
        // Regras separadas por operação (nunca `write` amplo): OR anularia as validações.
        allow create: if (isOwner(visitId, request.auth.uid) || isAdmin(visitId, request.auth.uid))
          && request.resource.data.role in ['admin', 'editor', 'viewer']
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.visitId == visitId
          && request.resource.data.createdAt == request.time;

        // Update (revogação): owner/admin. Apenas revokedAt/updatedAt podem mudar
        // (protege tokenHash/expiresAt contra alteração indevida); papel imutável,
        // identidade preservada e tipos dos campos de revogação validados.
        allow update: if (isOwner(visitId, request.auth.uid) || isAdmin(visitId, request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt', 'updatedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.visitId == resource.data.visitId
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && (request.resource.data.revokedAt == null || request.resource.data.revokedAt is timestamp)
          && request.resource.data.updatedAt is timestamp;
      }
    }

    // ===============================
    // Collection Group ACL (query)
    // ===============================
    // Necessário para permitir collectionGroup('members') no pull de hidratação.
    // Permite somente memberships do próprio usuário autenticado.
    match /{documentPath=**}/members/{memberUserId} {
      allow get, list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ===============================
    // Notas: hardening com validações
    // ===============================
    match /users/{userId}/notes/{noteId} {
      
      // Owner check: usuário só pode acessar suas próprias notas
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Delete: apenas owner
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Create: validações mínimas de estrutura
      allow create: if request.auth != null 
        && request.auth.uid == userId
        && isValidNoteCreate(request.resource.data, userId, noteId);

      // Update: validações mínimas
      allow update: if request.auth != null 
        && request.auth.uid == userId
        && isValidNoteUpdate(request.resource.data, request.resource.data, userId, noteId);
    }

    // ===============================
    // Outras coleções: owner simples
    // ===============================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }

  // ===============================
  // Funções de validação
  // ===============================

  // Valida criação de nota
  function isValidNoteCreate(data, pathUserId, noteId) {
    return data.bed is string
      && data.note is string
      && data.date is string
      && data.createdAt is timestamp
      && data.expiresAt is timestamp
      && data.userId == pathUserId
      && data.id == noteId
      && data.bed.size() <= 100
      && data.note.size() <= 2000
      && data.date.size() == 10
      && (data.reference == null || (data.reference is string && data.reference.size() <= 100))
      && (data.syncStatus == null || data.syncStatus == 'pending')
      && (data.syncedAt == null || data.syncedAt is timestamp)
      && (data.updatedAt == null || data.updatedAt is timestamp);
  }

  // Valida atualização de nota
  function isValidNoteUpdate(newData, oldData, pathUserId, noteId) {
    return newData.userId == oldData.userId
      && newData.userId == pathUserId
      && newData.id == oldData.id
      && newData.id == noteId
      && (newData.bed == null || (newData.bed is string && newData.bed.size() <= 100))
      && (newData.note == null || (newData.note is string && newData.note.size() <= 2000))
      && (newData.reference == null || (newData.reference is string && newData.reference.size() <= 100))
      && (newData.date == null || (newData.date is string && newData.date.size() == 10))
      && newData.createdAt == oldData.createdAt
      && (newData.expiresAt == null || newData.expiresAt is timestamp)
      && (newData.updatedAt == null || newData.updatedAt is timestamp);
  }
}
